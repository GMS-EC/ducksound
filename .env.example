# Variables de entorno para DuckSound
# Copia este fichero a .env y reemplaza los valores por los tuyos.

# ─── REQUERIDO ────────────────────────────────────────────────
# Ruta a tu carpeta de música en el host
MUSIC_PATH=C:/Ruta/A/Tu/Musica

# Token para proteger los endpoints de administración (/admin/*)
ADMIN_SECRET_TOKEN=changeme_super_secret_token

# ─── DOCKER COMPOSE ───────────────────────────────────────────
# Puerto del servidor web (por defecto 8604)
PORT=8604

# Número de workers del servidor web
WEB_WORKERS=4

# Número de hilos por worker
WEB_THREADS=2

# Nivel de log (debug / info / warning / error)
LOG_LEVEL=info

# ─── REDIS (para tareas background) ──────────────────────────
# Si usas docker-compose, estos valores ya están configurados.
# Para desarrollo local sin Docker, instala Redis y deja los valores por defecto.
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── OPCIONAL ─────────────────────────────────────────────────
# Entorno Flask (production / development)
FLASK_ENV=production