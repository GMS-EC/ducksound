# ===================================
# Variables de entorno para DuckSound
# ===================================

# ─── REQUERIDO ────────────────────────────────────────────────
# Ruta a tu carpeta física de música en el sistema host
# Ejemplos:
# Windows: MUSIC_PATH=E:/Musica  o  MUSIC_PATH=C:/Users/marcu/Music
# Linux:   MUSIC_PATH=/home/usuario/Music
MUSIC_PATH=E:/Musica

# Credenciales del usuario administrador para iniciar sesión en la web
ADMIN_USERNAME=ducksound
ADMIN_PASSWORD=ducksound

# Token para endpoints de administración protegidos
ADMIN_SECRET_TOKEN=ducksound_admin_token

# ─── SERVIDOR ─────────────────────────────────────────────────
PORT=8604
WEB_WORKERS=2
WEB_THREADS=2
LOG_LEVEL=info

# ─── SEGURIDAD (Opcional) ─────────────────────────────────────
# Dejar vacío para que DuckSound genere y persista una clave automáticamente
SECRET_KEY=