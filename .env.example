# ==============================================================
# Variables de entorno para DuckSound (Modo Ultra-Ligero SQLite)
# ==============================================================

# ─── REQUERIDO ────────────────────────────────────────────────
# Ruta a tu carpeta física de música en el sistema host
# Ejemplos:
# Windows: MUSIC_PATH=E:/Musica  o  MUSIC_PATH=C:/Users/marcu/Music
# Linux:   MUSIC_PATH=/home/usuario/Music
MUSIC_PATH=E:/Musica

# Token para endpoints de administración protegidos
ADMIN_SECRET_TOKEN=ducksound_admin_token

# ─── SERVIDOR ─────────────────────────────────────────────────
PORT=8604
WEB_WORKERS=2
WEB_THREADS=2
LOG_LEVEL=info

# ─── BASE DE DATOS (Por defecto SQLite en /data/ducksound.db) ──
# Dejar vacío para usar SQLite ultra-ligero (0 MB de consumo extra).
# Si deseas usar PostgreSQL externo:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/ducksound
DATABASE_URL=

# ─── SEGURIDAD (Opcional) ─────────────────────────────────────
# Dejar vacío para que DuckSound genere y persista una clave automáticamente
SECRET_KEY=