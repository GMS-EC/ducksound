# Variables de entorno para DuckSound
# Copia este fichero a .env y reemplaza los valores por los tuyos.

# ─── REQUERIDO ────────────────────────────────────────────────
# Ruta a tu carpeta de música en el host
MUSIC_PATH=C:/Ruta/A/Tu/Musica

# Token para proteger los endpoints de administración
ADMIN_SECRET_TOKEN=changeme_super_secret_token

# ─── BASE DE DATOS (PostgreSQL) ──────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ducksound
DB_USER=ducksound
DB_PASSWORD=ducksound

# La URL se construye automáticamente como:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── REDIS (para tareas background) ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── DOCKER COMPOSE ───────────────────────────────────────────
PORT=8604
WEB_WORKERS=4
WEB_THREADS=2
LOG_LEVEL=info

# ─── OPCIONAL ─────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=