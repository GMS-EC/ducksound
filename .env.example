# Variables de entorno para DuckSound
# Copia este fichero a .env y reemplaza los valores por los tuyos.

# ─── REQUERIDO ────────────────────────────────────────────────
# Ruta a tu carpeta de música en el host
MUSIC_PATH=C:/Ruta/A/Tu/Musica

# Token para proteger los endpoints de administración (/admin/*)
ADMIN_SECRET_TOKEN=changeme_super_secret_token

# ─── OPCIONAL ─────────────────────────────────────────────────
# Entorno Flask (production / development)
FLASK_ENV=production